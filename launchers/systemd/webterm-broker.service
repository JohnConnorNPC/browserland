# webterm broker unit. Install:
#   sudo cp launchers/systemd/webterm-broker.service /etc/systemd/system/
#   edit User/WorkingDirectory/ExecStart paths and the token, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now webterm-broker
#
# Set an EXPLICIT token here (#142). Left unset the broker mints one into
# webterm_token.json beside its state store, which works - but under systemd
# the value is never printed to a terminal, so you would have to fetch it with
#   python3 -m webterm.broker --print-token
#
# ExecStart's `exec` (launcher wrapper) makes the supervisor the main PID
# (#183): the launcher shells to a supervisor that starts the actual server,
# and systemd's KillMode=control-group then brings the worker down when the
# supervisor stops. Restart= below applies to the supervisor's exit code — the
# worker always exits when signalled by the supervisor, so the supervisor's
# handling is what matters here. A worker exit-75 (restart request) causes the
# supervisor to re-spawn, which systemd sees as the supervisor staying alive
# (it manages the worker internally). An actual supervisor crash is rare and
# is a different exit code (70). systemd's own restart budget (StartLimitBurst
# / StartLimitIntervalSec) sits on top of the supervisor's (five relaunches
# per minute with exponential backoff); either or both can be exhausted.
[Unit]
Description=webterm broker (WebSocket terminal relay on :4445)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webterm
WorkingDirectory=/opt/web_terminal
Environment=WEB_TERMINAL_TOKEN=changeme
ExecStart=/opt/web_terminal/launchers/run-broker.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
